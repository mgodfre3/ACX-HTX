          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.42.1.51946",
              "templateHash": "7839179346614311041"
            }
          },
          "parameters": {
            "location": {
              "type": "string",
              "metadata": {
                "description": "Azure region."
              }
            },
            "namePrefix": {
              "type": "string",
              "metadata": {
                "description": "Short name prefix."
              }
            },
            "tags": {
              "type": "object",
              "metadata": {
                "description": "Tags applied to every resource."
              }
            }
          },
          "variables": {
            "suffix": "[uniqueString(resourceGroup().id)]",
            "hubStorageName": "[toLower(format('{0}fdystg{1}', parameters('namePrefix'), substring(variables('suffix'), 0, 8)))]",
            "hubKvName": "[toLower(format('{0}-fdy-kv-{1}', parameters('namePrefix'), substring(variables('suffix'), 0, 6)))]",
            "hubAiName": "[toLower(format('{0}-fdy-ai-{1}', parameters('namePrefix'), substring(variables('suffix'), 0, 6)))]",
            "hubName": "[format('{0}-foundry-hub', parameters('namePrefix'))]",
            "projectName": "[format('{0}-foundry-proj', parameters('namePrefix'))]"
          },
          "resources": [
            {
              "type": "Microsoft.Storage/storageAccounts",
              "apiVersion": "2023-05-01",
              "name": "[variables('hubStorageName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "sku": {
                "name": "Standard_LRS"
              },
              "kind": "StorageV2",
              "properties": {
                "minimumTlsVersion": "TLS1_2",
                "allowBlobPublicAccess": false,
                "supportsHttpsTrafficOnly": true
              }
            },
            {
              "type": "Microsoft.KeyVault/vaults",
              "apiVersion": "2024-04-01-preview",
              "name": "[variables('hubKvName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "properties": {
                "sku": {
                  "family": "A",
                  "name": "standard"
                },
                "tenantId": "[subscription().tenantId]",
                "enableRbacAuthorization": true,
                "enableSoftDelete": true,
                "softDeleteRetentionInDays": 7
              }
            },
            {
              "type": "Microsoft.Insights/components",
              "apiVersion": "2020-02-02",
              "name": "[variables('hubAiName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "kind": "web",
              "properties": {
                "Application_Type": "web",
                "Request_Source": "rest"
              }
            },
            {
              "type": "Microsoft.MachineLearningServices/workspaces",
              "apiVersion": "2024-07-01-preview",
              "name": "[variables('hubName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "kind": "Hub",
              "identity": {
                "type": "SystemAssigned"
              },
              "sku": {
                "name": "Basic",
                "tier": "Basic"
              },
              "properties": {
                "friendlyName": "HTX Foundry Hub",
                "description": "AI Foundry hub representing commercial-GPU less-sensitive processing.",
                "storageAccount": "[resourceId('Microsoft.Storage/storageAccounts', variables('hubStorageName'))]",
                "keyVault": "[resourceId('Microsoft.KeyVault/vaults', variables('hubKvName'))]",
                "applicationInsights": "[resourceId('Microsoft.Insights/components', variables('hubAiName'))]",
                "publicNetworkAccess": "Enabled"
              },
              "dependsOn": [
                "[resourceId('Microsoft.Insights/components', variables('hubAiName'))]",
                "[resourceId('Microsoft.KeyVault/vaults', variables('hubKvName'))]",
                "[resourceId('Microsoft.Storage/storageAccounts', variables('hubStorageName'))]"
              ]
            },
            {
              "type": "Microsoft.MachineLearningServices/workspaces",
              "apiVersion": "2024-07-01-preview",
              "name": "[variables('projectName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "kind": "Project",
              "identity": {
                "type": "SystemAssigned"
              },
              "sku": {
                "name": "Basic",
                "tier": "Basic"
              },
              "properties": {
                "friendlyName": "HTX Foundry Project",
                "hubResourceId": "[resourceId('Microsoft.MachineLearningServices/workspaces', variables('hubName'))]",
                "publicNetworkAccess": "Enabled"
              },
              "dependsOn": [
                "[resourceId('Microsoft.MachineLearningServices/workspaces', variables('hubName'))]"
              ]
            }
          ],
          "outputs": {
            "hubName": {
              "type": "string",
              "value": "[variables('hubName')]"
            },
            "projectName": {
              "type": "string",
              "value": "[variables('projectName')]"
            },
            "hubId": {
              "type": "string",
              "value": "[resourceId('Microsoft.MachineLearningServices/workspaces', variables('hubName'))]"
            }
          }
        }
      },
      "dependsOn": [
        "[subscriptionResourceId('Microsoft.Resources/resourceGroups', parameters('resourceGroupName'))]"
      ]
    }
  ],
  "outputs": {
    "resourceGroupName": {
      "type": "string",
      "value": "[parameters('resourceGroupName')]"
    },
    "keyVaultName": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'kv-deploy'), '2025-04-01').outputs.keyVaultName.value]"
    },
    "kekName": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'kv-deploy'), '2025-04-01').outputs.kekName.value]"
    },
    "storageAccountName": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'storage-deploy'), '2025-04-01').outputs.storageAccountName.value]"
    },
    "coldContainerName": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'storage-deploy'), '2025-04-01').outputs.coldContainerName.value]"
    },
    "cvmName": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'cvm-deploy'), '2025-04-01').outputs.cvmName.value]"
    },
    "cvmPrincipalId": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'cvm-deploy'), '2025-04-01').outputs.cvmPrincipalId.value]"
    },
    "cvmPublicIp": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'cvm-deploy'), '2025-04-01').outputs.publicIpAddress.value]"
    },
    "foundryHubName": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'foundry-deploy'), '2025-04-01').outputs.hubName.value]"
    },
    "foundryProjectName": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'foundry-deploy'), '2025-04-01').outputs.projectName.value]"
    }
  }
}