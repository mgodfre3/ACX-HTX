              }
            },
            "tags": {
              "type": "object",
              "metadata": {
                "description": "Tags applied to every resource."
              }
            },
            "customLocationId": {
              "type": "string",
              "metadata": {
                "description": "Custom Location resource ID."
              }
            },
            "logicalNetworkName": {
              "type": "string",
              "metadata": {
                "description": "Existing logical network name."
              }
            },
            "logicalNetworkResourceGroup": {
              "type": "string",
              "metadata": {
                "description": "Resource group containing the logical network."
              }
            },
            "windowsGalleryImageId": {
              "type": "string",
              "metadata": {
                "description": "Gallery image resource ID for Windows Server 2025."
              }
            },
            "adminUsername": {
              "type": "string",
              "metadata": {
                "description": "Local admin username."
              }
            },
            "adminPassword": {
              "type": "securestring",
              "metadata": {
                "description": "Local admin password."
              }
            },
            "vmSize": {
              "type": "string",
              "defaultValue": "Standard_A4_v2",
              "metadata": {
                "description": "VM size."
              }
            }
          },
          "variables": {
            "vmName": "[format('{0}-jumpbox', parameters('namePrefix'))]",
            "nicName": "[format('{0}-nic', variables('vmName'))]"
          },
          "resources": [
            {
              "type": "Microsoft.HybridCompute/machines",
              "apiVersion": "2024-07-10",
              "name": "[variables('vmName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "kind": "AzureStackHCI",
              "identity": {
                "type": "SystemAssigned"
              },
              "properties": {}
            },
            {
              "type": "Microsoft.AzureStackHCI/networkInterfaces",
              "apiVersion": "2024-01-01",
              "name": "[variables('nicName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "extendedLocation": {
                "type": "CustomLocation",
                "name": "[parameters('customLocationId')]"
              },
              "properties": {
                "ipConfigurations": [
                  {
                    "name": "ipconfig1",
                    "properties": {
                      "subnet": {
                        "id": "[resourceId(parameters('logicalNetworkResourceGroup'), 'Microsoft.AzureStackHCI/logicalNetworks', parameters('logicalNetworkName'))]"
                      }
                    }
                  }
                ]
              }
            },
            {
              "type": "Microsoft.AzureStackHCI/virtualMachineInstances",
              "apiVersion": "2024-01-01",
              "scope": "[resourceId('Microsoft.HybridCompute/machines', variables('vmName'))]",
              "name": "default",
              "extendedLocation": {
                "type": "CustomLocation",
                "name": "[parameters('customLocationId')]"
              },
              "properties": {
                "hardwareProfile": {
                  "vmSize": "[parameters('vmSize')]"
                },
                "osProfile": {
                  "adminUsername": "[parameters('adminUsername')]",
                  "adminPassword": "[parameters('adminPassword')]",
                  "computerName": "htxjumpbox",
                  "windowsConfiguration": {
                    "provisionVMAgent": true,
                    "enableAutomaticUpdates": true
                  }
                },
                "storageProfile": {
                  "imageReference": {
                    "id": "[parameters('windowsGalleryImageId')]"
                  },
                  "osDisk": {
                    "osType": "Windows"
                  }
                },
                "networkProfile": {
                  "networkInterfaces": [
                    {
                      "id": "[resourceId('Microsoft.AzureStackHCI/networkInterfaces', variables('nicName'))]"
                    }
                  ]
                },
                "securityProfile": {
                  "enableTPM": true
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.HybridCompute/machines', variables('vmName'))]",
                "[resourceId('Microsoft.AzureStackHCI/networkInterfaces', variables('nicName'))]"
              ]
            }
          ],
          "outputs": {
            "vmName": {
              "type": "string",
              "value": "[variables('vmName')]"
            },
            "privateIpAddress": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.AzureStackHCI/networkInterfaces', variables('nicName')), '2024-01-01').ipConfigurations[0].properties.privateIPAddress]"
            }
          }
        }
      },
      "dependsOn": [
        "[subscriptionResourceId('Microsoft.Resources/resourceGroups', parameters('resourceGroupName'))]"
      ]
    }
  ],
  "outputs": {
    "resourceGroupName": {
      "type": "string",
      "value": "[parameters('resourceGroupName')]"
    },
    "vaultVmName": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'vault-deploy'), '2025-04-01').outputs.vmName.value]"
    },
    "vaultVmPrivateIp": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'vault-deploy'), '2025-04-01').outputs.privateIpAddress.value]"
    },
    "aksArcClusterName": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'aks-arc-deploy'), '2025-04-01').outputs.connectedClusterName.value]"
    },
    "connectedRegistryInstallHint": {
      "type": "string",
      "value": "[format('Run: az acr connected-registry install info --registry {0} --name aldo-tokyo-wkld', parameters('sovereignAcrName'))]"
    }
  }
}