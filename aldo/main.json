    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "Autonomous",
      "metadata": {
        "description": "Azure region for ALDO resources. Always \"Autonomous\" for ALDO stamps."
      }
    },
    "resourceGroupName": {
      "type": "string",
      "defaultValue": "ACX-HTX-ALDO",
      "metadata": {
        "description": "Resource group name for the ALDO-side sovereign stack."
      }
    },
    "namePrefix": {
      "type": "string",
      "defaultValue": "htxaldo",
      "minLength": 3,
      "maxLength": 8,
      "metadata": {
        "description": "Short name prefix."
      }
    },
    "customLocationId": {
      "type": "string",
      "metadata": {
        "description": "Custom Location resource ID of the ALDO Tokyo-WKLD stamp."
      }
    },
    "logicalNetworkName": {
      "type": "string",
      "metadata": {
        "description": "Existing logical network name on the ALDO stamp."
      }
    },
    "logicalNetworkResourceGroup": {
      "type": "string",
      "defaultValue": "[parameters('resourceGroupName')]",
      "metadata": {
        "description": "Resource group that contains the existing logical network."
      }
    },
    "ubuntuGalleryImageId": {
      "type": "string",
      "metadata": {
        "description": "Gallery image resource ID for Ubuntu 24.04 (Vault VM)."
      }
    },
    "windowsGalleryImageId": {
      "type": "string",
      "metadata": {
        "description": "Gallery image resource ID for Windows Server 2025 (Foundry + optional jumpbox)."
      }
    },
    "deployJumpbox": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Deploy the optional Windows Server 2025 jumpbox VM."
      }
    },
    "vaultAdminSshPublicKey": {
      "type": "string",
      "metadata": {
        "description": "SSH public key for the Vault VM admin user."
      }
    },
    "vaultAdminUsername": {
      "type": "string",
      "defaultValue": "htxadmin",
      "metadata": {
        "description": "Admin username for the Vault VM."
      }
    },
    "windowsAdminUsername": {
      "type": "string",
      "defaultValue": "htxadmin",
      "metadata": {
        "description": "Admin username for Windows VMs (Foundry + jumpbox)."
      }
    },
    "foundryAdminPassword": {
      "type": "securestring",
      "metadata": {
        "description": "Admin password for the Foundry Windows VM."
      }
    },
    "jumpboxAdminPassword": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Admin password for the optional jumpbox."
      }
    },
    "foundryGpuName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "GPU name as reported by Get-VMHostPartitionableGpu on the ALDO cluster. Blank = CPU-only Foundry Local."
      }
    },
    "sovereignAcrName": {
      "type": "string",
      "defaultValue": "acxhtxacraguuve6o",
      "metadata": {
        "description": "Sovereign ACR name in ACX-HTX (used for post-deploy Connected Registry install)."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {
        "Project": "HTX",
        "Created By": "Michael Godfrey",
        "Environment": "ALDO-Tokyo-WKLD"
      },
      "metadata": {
        "description": "Tags applied to every resource."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Resources/resourceGroups",
      "apiVersion": "2024-03-01",
      "name": "[parameters('resourceGroupName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]"
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
