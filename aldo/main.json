              "value": "[reference(resourceId('Microsoft.HybridCompute/machines', variables('vmName')), '2024-07-10', 'full').identity.principalId]"
            }
          }
        }
      },
      "dependsOn": [
        "[subscriptionResourceId('Microsoft.Resources/resourceGroups', parameters('resourceGroupName'))]"
      ]
