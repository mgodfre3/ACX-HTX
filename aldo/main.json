              "type": "int",
              "defaultValue": 4,
              "metadata": {
                "description": "vCPU count (Azure Local sizes VMs by memoryMB + processors, not vmSize)."
              }
            },
            "memoryMB": {
              "type": "int",
              "defaultValue": 8192,
              "metadata": {
                "description": "Memory in MB."
              }
            }
          },
          "variables": {
            "vmName": "[format('{0}-vault', parameters('namePrefix'))]",
            "nicName": "[format('{0}-nic', variables('vmName'))]"
          },
          "resources": [
            {
              "type": "Microsoft.AzureStackHCI/networkInterfaces",
              "apiVersion": "2025-02-01-preview",
              "name": "[variables('nicName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "extendedLocation": {
                "type": "CustomLocation",
                "name": "[parameters('customLocationId')]"
              },
              "properties": {
                "ipConfigurations": [
                  {
                    "name": "ipconfig1",
                    "properties": {
                      "subnet": {
                        "id": "[resourceId(parameters('logicalNetworkResourceGroup'), 'Microsoft.AzureStackHCI/logicalNetworks', parameters('logicalNetworkName'))]"
                      }
                    }
                  }
                ]
              }
            },
            {
              "type": "Microsoft.HybridCompute/machines",
              "apiVersion": "2024-07-10",
              "name": "[variables('vmName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "kind": "HCI",
              "identity": {
                "type": "SystemAssigned"
              },
              "properties": {}
            },
            {
              "type": "Microsoft.AzureStackHCI/virtualMachineInstances",
              "apiVersion": "2025-02-01-preview",
              "scope": "[resourceId('Microsoft.HybridCompute/machines', variables('vmName'))]",
              "name": "default",
              "extendedLocation": {
                "type": "CustomLocation",
                "name": "[parameters('customLocationId')]"
              },
              "properties": {
                "hardwareProfile": {
                  "processors": "[parameters('processorCount')]",
                  "memoryMB": "[parameters('memoryMB')]"
                },
                "osProfile": {
                  "adminUsername": "[parameters('adminUsername')]",
                  "computerName": "htxvault",
                  "linuxConfiguration": {
                    "disablePasswordAuthentication": true,
                    "provisionVMAgent": true,
                    "provisionVMConfigAgent": true,
                    "ssh": {
                      "publicKeys": [
                        {
                          "keyData": "[parameters('adminSshPublicKey')]",
                          "path": "[format('/home/{0}/.ssh/authorized_keys', parameters('adminUsername'))]"
                        }
                      ]
                    }
                  }
                },
                "storageProfile": {
                  "imageReference": {
                    "id": "[parameters('ubuntuGalleryImageId')]"
                  },
                  "osDisk": {
                    "osType": "Linux"
                  }
                },
                "networkProfile": {
                  "networkInterfaces": [
                    {
                      "id": "[resourceId('Microsoft.AzureStackHCI/networkInterfaces', variables('nicName'))]"
                    }
                  ]
                },
                "securityProfile": {
                  "enableTPM": true
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.HybridCompute/machines', variables('vmName'))]",
                "[resourceId('Microsoft.AzureStackHCI/networkInterfaces', variables('nicName'))]"
              ]
            }
          ],
          "outputs": {
            "vmName": {
              "type": "string",
              "value": "[variables('vmName')]"
            },
            "arcMachineId": {
              "type": "string",
