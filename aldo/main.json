          "namePrefix": {
            "value": "[parameters('namePrefix')]"
          },
          "tags": {
            "value": "[parameters('tags')]"
          },
          "customLocationId": {
            "value": "[parameters('customLocationId')]"
          },
          "logicalNetworkName": {
            "value": "[parameters('logicalNetworkName')]"
          },
          "logicalNetworkResourceGroup": {
            "value": "[parameters('logicalNetworkResourceGroup')]"
          },
          "ubuntuGalleryImageId": {
            "value": "[parameters('ubuntuGalleryImageId')]"
          },
          "adminUsername": {
            "value": "[parameters('vaultAdminUsername')]"
          },
          "adminSshPublicKey": {
            "value": "[parameters('vaultAdminSshPublicKey')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.42.1.51946",
              "templateHash": "1713039323444537006"
            }
          },
